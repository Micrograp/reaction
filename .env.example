# Telegram Bot Tokens (comma-separated or single)
BOT_TOKENS=YOUR_BOT_TOKEN_HERE

# Admin Telegram user ID (optional)
ADMIN_ID=0

# Reaction emojis separated by space
REACTION_EMOJIS=👍 ❤️ 🔥 🎉 🤩 👏 ⚡

# Reaction mode: random or fixed
REACTION_MODE=random

# Reaction delay range in seconds
MIN_DELAY=0.5
MAX_DELAY=2.0
